{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tuner Output Schema (SaaP Deliverable)",
  "type": "object",
  "properties": {
    "task": {
      "type": "object",
      "properties": {
        "pipeline_id": { "type": "string" },
        "config_ids": { "type": "array", "items": { "type": "string" } },
        "input_data_list": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["pipeline_id", "config_ids", "input_data_list"]
    },
    "deliverables": {
      "type": "object",
      "description": "The final packaged artifacts for the SaaP delivery.",
      "properties": {
        "successful_runs_archive": {
          "type": "string",
          "description": "Filename of the successful runs ZIP (e.g., successful_runs_<branch_name>.zip)."
        },
        "failed_runs_archive": {
          "type": "string",
          "description": "Filename of the failed runs ZIP (e.g., failed_runs_<branch_name>.zip)."
        },
        "saap_skeleton": {
          "type": "string",
          "description": "Path to the root of the generated saap_skeleton folder structure."
        }
      },
      "required": [
        "successful_runs_archive",
        "failed_runs_archive",
        "saap_skeleton"
      ]
    }
  },
  "required": ["task", "deliverables"]
}