{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tuner Execution Task Schema",
  "type": "object",
  "properties": {
    "pipeline_id": {
      "type": "string",
      "description": "Identifier for the target YAML in Library."
    },
    "steps": {
      "type": "object",
      "description": "Pipeline execution steps map.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "input_file_name": { "type": "string" },
          "output_file_name": { "type": "string" },
          "input_output_folder": { "type": "string" }
        },
        "required": ["input_file_name", "output_file_name", "input_output_folder"],
        "additionalProperties": false
      }
    }
  },
  "required": ["pipeline_id", "steps"]
}